# Copy this file to ".env" (same folder) and fill in YOUR values.
# ".env" is in .gitignore and is never pushed. Never put a token into a notebook.

# Shared MLflow server on DagsHub (same for the whole team)
MLFLOW_TRACKING_URI=https://dagshub.com/annihlj/AIOps_PromptGuard.mlflow

# Your OWN DagsHub user name and access token (DagsHub -> Settings -> Tokens)
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>
